# Copy to .env, fill in each value, and make it readable by its owner alone:
#   cp env.example .env && chmod 600 .env
#
# Every line here is passed to the byrle container too, so any setting `byrle --help`
# lists can be added below.

# The release image, by the digest its attestation names. Verify it as docs/runbook.md's
# "1. Install and verify" says, then pin it:
#   docker buildx imagetools inspect ghcr.io/krishardy/byrle:0.1.0    (its Digest: line)
# and set ghcr.io/krishardy/byrle:0.1.0@sha256:<digest>.
BYRLE_IMAGE=ghcr.io/krishardy/byrle:0.1.0

# The address every installing machine reaches: nginx's, with its port if not 443.
# Lockfiles record it.
BYRLE_PROXY_URL=https://byrle.example.com

# The certificate chain and key for that name, on the host.
BYRLE_TLS_CERT=/etc/letsencrypt/live/byrle.example.com/fullchain.pem
BYRLE_TLS_KEY=/etc/letsencrypt/live/byrle.example.com/privkey.pem

# The port nginx publishes on the host.
BYRLE_HTTPS_PORT=443

# openssl rand -hex 32, for each. The password is written into a URL, so keep it to hex.
POSTGRES_PASSWORD=
BYRLE_RP_KEY=

# observe for the first week: what the policy refuses is served and logged.
# Remove the line to enforce, then: docker compose up -d
BYRLE_MODE=observe

# Optional: byrle refresh loads GitHub's Advisory Database with it.
#BYRLE_GITHUB_TOKEN=
