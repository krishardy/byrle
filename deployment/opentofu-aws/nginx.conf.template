# docs/fronting-tls.md's server block, behind the load balancer, which terminates TLS. config.sh
# fills in ${BYRLE_VPC_CIDR} and ${BYRLE_RP_KEY} when the task starts.
#
# The load balancer appends the client's address to X-Forwarded-For. set_real_ip_from and
# real_ip_header make $remote_addr that address, the last entry, when the request came from
# inside the VPC: from the load balancer.
server {
    listen 80 default_server;
    server_name _;

    set_real_ip_from ${BYRLE_VPC_CIDR};
    real_ip_header X-Forwarded-For;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Byrle-RP-Key ${BYRLE_RP_KEY};
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
