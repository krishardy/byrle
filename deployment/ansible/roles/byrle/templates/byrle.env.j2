# {{ ansible_managed }}
# Read by byrle.service, byrle-refresh.service and byrle-admin.
BYRLE_DATABASE_URL={{ byrle_database_url }}
BYRLE_LISTEN={{ byrle_listen }}
BYRLE_PROXY_URL={{ byrle_proxy_url }}
BYRLE_RP_KEY={{ byrle_rp_key }}
BYRLE_POLICY=/etc/byrle/policy.yaml
BYRLE_SPOOL_DIR=/var/lib/byrle/spool
BYRLE_AUDIT_LOG=/var/log/byrle/audit.jsonl
BYRLE_ACCOUNT_EVENT_LOG=/var/log/byrle/account-events.jsonl
{% if byrle_mode %}
BYRLE_MODE={{ byrle_mode }}
{% endif %}
{% if byrle_github_token %}
BYRLE_GITHUB_TOKEN={{ byrle_github_token }}
{% endif %}
{% for name, value in byrle_environment | dictsort %}
{{ name }}={{ value }}
{% endfor %}
