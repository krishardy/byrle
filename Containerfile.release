# The release image: the static binary a release attested, for the platform being built,
# on distroless static: CA certificates and time zones, with no libc and no shell. Built by .github/workflows/release.yml from the context
# scripts/make/release-image-context.sh writes; Containerfile builds from source instead.
FROM gcr.io/distroless/static-debian13:nonroot
ARG TARGETARCH
COPY dist/image/${TARGETARCH}/byrle /usr/local/bin/byrle
USER nonroot
ENTRYPOINT ["byrle"]
CMD ["daemon"]
