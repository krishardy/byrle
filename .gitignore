# Never commit a credential. `make trufflehog` scans the working tree and does not read
# this file, so a token here fails that gate as well as risking a commit.
.env
.env.*
/dist/

# Documents kept out of the public repository, such as an unfixed security review.
/.*
# Dot-directories that are part of the repository.
!/.sqlx/
!/.github/
