target/
vendor/
mutants.out/
mutants.out.old/

# Never commit a credential. `make trufflehog` scans the working tree and does not read
# this file, so a token here fails that gate as well as risking a commit.
.env
.env.*
/dist/
/.tmp/

# Documents kept out of the public repository, such as an unfixed security review.
/.*

# Dot-directories that are part of the repository.
!/.sqlx/
!/.github/

# An operator's settings and secrets for deployment/.
/deployment/compose/.env
/deployment/ansible/inventory.yml
/deployment/ansible/group_vars/
/deployment/terraform-aws/.terraform/
/deployment/terraform-aws/.terraform.lock.hcl
/deployment/terraform-aws/terraform.tfvars
/deployment/terraform-aws/*.tfstate
/deployment/terraform-aws/*.tfstate.*
